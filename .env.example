# Copy to .env and fill in. Never commit .env.

# --- Database ---
# App runtime connection (restricted role — cannot UPDATE/DELETE ledger_entries).
DATABASE_URL=postgresql://treasury_app:treasury@localhost:5432/treasury_dev
# Migration connection (owns the schema; used only by `pnpm db:migrate`).
MIGRATOR_DATABASE_URL=postgresql://treasury_migrator:treasury@localhost:5432/treasury_dev

# --- API ---
API_PORT=3000
API_LOG_LEVEL=info
# Comma-separated API keys accepted for the seeded demo org, in "label:key" form.
# In a real deployment keys are issued via the API and stored hashed — see docs/THREAT_MODEL.md.
API_SEED_ORG_API_KEY=demo-org-key

# --- x402 payment rail ---
# "mock" (default, used by CI/tests/`pnpm demo:research`) or "real" (Base Sepolia, manual only).
X402_ADAPTER_MODE=mock

# Only required when X402_ADAPTER_MODE=real. See docs/RESEARCH.md §10/§12/§13.
# A v2-compatible x402 facilitator base URL you control or trust.
# https://x402.org/facilitator is the public, Coinbase-operated, testnet-only
# facilitator (verified 2026-09-26) — a reasonable default, but confirm it is
# still operating before relying on it.
X402_FACILITATOR_URL=https://x402.org/facilitator
# CAIP-2 network id. This project only supports Base Sepolia.
X402_NETWORK=eip155:84532
# Base Sepolia EOA private key. Needs ONLY test USDC (no testnet ETH — the
# exact/EIP-3009 flow is gasless for the payer; the facilitator pays gas).
# Fund the corresponding address at https://faucet.circle.com.
# NEVER a mainnet key or a key holding real funds. NEVER commit this.
X402_PAYER_PRIVATE_KEY=
# Address demo providers are paid to. Any valid address; no funding required.
X402_PAYTO_ADDRESS=

# --- Demo providers (apps/demo-provider-a, apps/demo-provider-b) ---
DEMO_PROVIDER_A_PORT=4001
DEMO_PROVIDER_B_PORT=4002
